#!/usr/bin/env python3
"""Keyboard lighting for the Legion Pro 7 Gen 10 (ITE 048d:c197), using Lenovo's lighting protocol
as documented by OpenRGB (LenovoUSBController_Gen7_8, Gen 10 packet format).

Effects run in the keyboard itself and are saved to its active lighting profile, so they stay
after reboots (also on Windows). Before the first change, the profile is backed up; the
"default" mode puts that backup back.

  legion-rgb info     profile, brightness and number of lights (read-only)
  legion-rgb apply [json]   apply these settings (default: ~/.config/legion-control/rgb.json)

rgb.json: {"brightness": 0-100,
           "zones": {"keyboard"|"front"|"back"|"logo":
                     {"mode": "default|off|static|breathing|wave|cycle|smooth|spiral",
                      "color": "#rrggbb", "speed": 1-10}}}
Light ids are zone << 8 | number: 0 keyboard, 1 front light bar, 3 back (rear vents), 5 lid logo.
"""
import fcntl
import glob
import json
import os
import sys

CONFIG = os.path.expanduser("~/.config/legion-control/rgb.json")
BACKUP_DIR = os.path.expanduser("~/.config/legion-control")
ZONES = {"keyboard": 0, "front": 1, "back": 3, "logo": 5}
ZONE_DEFAULT = {"mode": "default", "color": "#c2c1ff", "speed": 5}

PACKET = 960
REPORT = 0x07
SWITCH_PROFILE, GET_ACTIVE_PROFILE, SAVE_PROFILE, GET_PROFILE = 0xC8, 0xCA, 0xCB, 0xCC
GET_BRIGHTNESS, SET_BRIGHTNESS = 0xCD, 0xCE

# mode -> (effect code, colour mode, direction); colour mode 0 = effect's own, 1 = random, 2 = chosen colour
EFFECTS = {
    "static": (0x0B, 2, 0),
    "breathing": (0x04, 2, 0),
    "wave": (0x02, 0, 0x04),     # rainbow wave, left to right
    "cycle": (0x03, 1, 0),       # colour change, random colours (as OpenRGB)
    "smooth": (0x06, 1, 0),      # smooth colour fade, random colours
    "spiral": (0x01, 0, 0),      # spiral rainbow
}


def ioc(nr: int, size: int) -> int:
    return (3 << 30) | (size << 16) | (ord("H") << 8) | nr


def find_device() -> str | None:
    for h in glob.glob("/sys/class/hidraw/hidraw*"):
        try:
            uevent = open(f"{h}/device/uevent").read().upper()
            desc = open(f"{h}/device/report_descriptor", "rb").read()
        except OSError:
            continue
        # Lenovo vendor page 0xFF89, usage 0x07 (the 960-byte lighting report)
        if "0000048D:0000C197" in uevent and b"\x06\x89\xff\x09\x07" in desc:
            return f"/dev/{os.path.basename(h)}"
    return None


class Keyboard:
    def __init__(self, path: str):
        self.fd = os.open(path, os.O_RDWR)

    def send(self, payload: list, length: int | None = None) -> None:
        buf = bytearray(PACKET)
        buf[0] = REPORT
        buf[1:1 + len(payload)] = bytes(payload)
        n = (len(payload) - 3) if length is None else length  # bytes after the 4-byte header
        buf[2], buf[3] = n & 0xFF, (n >> 8) & 0xFF
        fcntl.ioctl(self.fd, ioc(0x06, PACKET), buf)

    def query(self, payload: list, length: int) -> bytes:
        self.send(payload, length)
        buf = bytearray(PACKET)
        buf[0] = REPORT
        fcntl.ioctl(self.fd, ioc(0x07, PACKET), buf)
        return bytes(buf)

    def profile_id(self) -> int:
        # Lenovo keyboards have a few profiles (1-6); anything else is a stale/odd reply, so use 1
        r = self.query([GET_ACTIVE_PROFILE, 0, 0], 1)
        return r[4] if 1 <= r[4] <= 6 else 1

    def brightness(self) -> int:
        return self.query([GET_BRIGHTNESS, 0, 0], 1)[4]

    def set_brightness(self, level: int) -> None:
        self.send([SET_BRIGHTNESS, 0, 0, max(0, min(9, level))], 1)

    def profile_raw(self, pid: int) -> bytes:
        return self.query([GET_PROFILE, 0, 0, pid], PACKET - 4)

    @staticmethod
    def parse_groups(r: bytes) -> list:
        """Groups from a GET_PROFILE answer: [{params: {k: v}, colors: [(r,g,b)], leds: [id]}]."""
        groups, i = [], 7
        while i < len(r) and r[i] != 0:
            i += 1
            params = {}
            cnt = r[i]; i += 1
            for _ in range(cnt):
                params[r[i]] = r[i + 1]; i += 2
            cnt = r[i]; i += 1
            colors = [tuple(r[i + 3 * k:i + 3 * k + 3]) for k in range(cnt)]; i += 3 * cnt
            cnt = r[i]; i += 1
            leds = [r[i + 2 * k] | r[i + 2 * k + 1] << 8 for k in range(cnt)]; i += 2 * cnt
            groups.append({"params": params, "colors": colors, "leds": leds})
        return groups

    def save_groups(self, pid: int, groups: list) -> None:
        """SAVE_PROFILE with the given groups (one packet; enough for a few groups of all lights)."""
        p = [SAVE_PROFILE, 0, 0, pid, 0x01, 0x01]
        for n, g in enumerate(groups, 1):
            params = g["params"]
            p += [n, 0x06]
            for k in range(1, 7):
                p += [k, params.get(k, 0)]
            p += [len(g["colors"])]
            for c in g["colors"]:
                p += list(c)
            p += [len(g["leds"])]
            for led in g["leds"]:
                p += [led & 0xFF, led >> 8]
        if len(p) + 1 > PACKET:
            raise ValueError("too much for one packet")
        self.send(p)


def load_config(text: str | None = None) -> dict:
    try:
        raw = json.loads(text) if text else json.load(open(CONFIG))
    except (OSError, ValueError):
        raw = {}
    # Older single-setting files: same setting for every zone
    flat = {k: raw[k] for k in ("mode", "color", "speed") if k in raw}
    zones = raw.get("zones", {})
    return {"brightness": raw.get("brightness", 100),
            "zones": {z: {**ZONE_DEFAULT, **flat, **zones.get(z, {})} for z in ZONES}}


def hex_rgb(h: str) -> tuple:
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4)) if len(h) == 6 else (255, 255, 255)


def open_keyboard() -> Keyboard:
    path = find_device()
    if not path:
        sys.exit("Keyboard lighting device (048d:c197) not found or not accessible")
    return Keyboard(path)


def backup_path(pid: int) -> str:
    return f"{BACKUP_DIR}/lenovo-profile-{pid}.bin"


def apply(text: str | None = None) -> None:
    kb = open_keyboard()
    cfg = load_config(text)
    pid = kb.profile_id()
    os.makedirs(BACKUP_DIR, exist_ok=True)
    backup = backup_path(pid)
    if not os.path.exists(backup):
        with open(backup, "wb") as f:
            f.write(kb.profile_raw(pid))

    original = Keyboard.parse_groups(open(backup, "rb").read())
    groups = []
    for zone, zid in ZONES.items():
        z = cfg["zones"][zone]
        mode = z["mode"]
        if mode == "off":
            continue  # lights left out of every group are off
        if mode == "default":
            # The zone's part of the original profile
            for g in original:
                leds = [led for led in g["leds"] if led >> 8 == zid]
                if leds:
                    groups.append({**g, "leds": leds})
            continue
        if mode not in EFFECTS:
            continue
        leds = sorted({led for g in original for led in g["leds"] if led >> 8 == zid})
        if not leds:
            continue
        effect, colour_mode, direction = EFFECTS[mode]
        speed = 1 + round((max(1, min(10, int(z["speed"]))) - 1) / 9 * 2)  # 1-3
        groups.append({"params": {1: effect, 2: speed, 3: 0, 4: direction, 5: colour_mode, 6: 0},
                       "colors": [hex_rgb(z["color"])] if colour_mode == 2 else [], "leds": leds})
    kb.save_groups(pid, groups)
    kb.send([SWITCH_PROFILE, 0, 0, pid], 1)  # make sure the profile just saved is the one showing
    kb.set_brightness(round(max(0, min(100, int(cfg["brightness"]))) / 100 * 9))
    print(f"applied to profile {pid}: " + ", ".join(f"{z} {cfg['zones'][z]['mode']}" for z in ZONES))


def info() -> None:
    kb = open_keyboard()
    pid = kb.profile_id()
    groups = Keyboard.parse_groups(kb.profile_raw(pid))
    # All lights: from the backup of the original profile when there is one (the current one may leave some off)
    backup = backup_path(pid)
    known = Keyboard.parse_groups(open(backup, "rb").read()) if os.path.exists(backup) else groups
    leds = {led for g in known for led in g["leds"]}
    print(f"profile {pid}, brightness {kb.brightness()}/9, {len(groups)} groups, {len(leds)} lights")
    for g in groups[:6]:
        print("  effect", hex(g["params"].get(1, 0)), "colours", g["colors"][:3], "lights", len(g["leds"]))


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "info":
        info()
    elif cmd == "apply":
        # Settings can be passed directly (the app does), so they can't be read before they're saved
        apply(sys.argv[2] if len(sys.argv) > 2 else None)
    else:
        sys.exit(__doc__)
